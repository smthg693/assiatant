# === Supabase ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# === Database ===
# Production: use Supabase PostgreSQL connection string
# Local dev: sqlite+aiosqlite:///./debug_dojo.db
DATABASE_URL=sqlite+aiosqlite:///./debug_dojo.db

# === Direct Judge0 CE ===
JUDGE0_BASE_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_LANGUAGE_ID=
JUDGE0_REQUEST_TIMEOUT=10
JUDGE0_EXECUTION_TIMEOUT=5
JUDGE0_POLL_INTERVAL=1
JUDGE0_MAX_POLL_TIME=30

# === Groq ===
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile

# === App ===
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_ENV=development
